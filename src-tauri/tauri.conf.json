{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "BaseLayerOS Console",
  "version": "2.0.0",
  "identifier": "com.fortresscodeai.baselayeros",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "BaseLayerOS Governance Console",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "app", "dmg"]
  },

  "plugins": {}
}
